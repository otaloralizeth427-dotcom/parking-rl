# Variables del SERVIDOR de la simulación (api/server.py). En Render se definen en render.yaml.
# Orígenes permitidos (web publicada), separados por coma:
PARKING_ALLOWED_ORIGINS=https://parking-rl.vercel.app
# Vistas previas de Vercel del mismo proyecto:
PARKING_ALLOWED_ORIGIN_REGEX=^https://parking-(rl|[a-z0-9]+-visua4)[a-z0-9-]*\.vercel\.app$
# 1 = versión publicada (sin entrenamiento desde la interfaz)
PARKING_PUBLIC=1
# Nivel con que abre la web si el link no trae ?level=
PARKING_LEVEL=N5
# Las variables de la WEB (VITE_API_BASE_URL, VITE_MLFLOW_URL) están en web/.env.example
